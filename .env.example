# ==========================================
# Crystal Scrims & Event Manager Bot Configuration
# ==========================================

# 1. Discord Bot Credentials
# Obtain these from the Discord Developer Portal: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here
# Optional: Set GUILD_ID during development for instant slash command registration
# DISCORD_DEV_GUILD_ID=your_testing_server_id_here

# 2. Database Driver Configuration
# Options: "turso" | "sqlite" | "postgres" (for Supabase / Neon)
DB_DRIVER=sqlite

# If DB_DRIVER=sqlite:
# Uses local embedded file. Perfect for zero-setup local development or small private servers.
DB_SQLITE_PATH=local.db

# If DB_DRIVER=turso:
# Get free 9GB LibSQL database from https://turso.tech/
TURSO_DATABASE_URL=libsql://your-database-name-username.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# If DB_DRIVER=postgres (Supabase / Neon):
# Get free Postgres from https://supabase.com/ or https://neon.tech/
DATABASE_URL=postgresql://postgres:password@db.xyz.supabase.co:5432/postgres

# 3. HTTP Server Port (Keep-Alive for Render / Koyeb / Fly.io)
# Render exposes PORT dynamically. The bot serves GET /health on this port.
PORT=8080

# 4. Optional Customization & Bot Defaults
DEFAULT_PREFIX=!
DEFAULT_CURRENCY=Coins
DEFAULT_MAX_SLOTS=25
