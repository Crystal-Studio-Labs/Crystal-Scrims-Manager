# ==========================================
# Crystal Scrims & Event Manager Bot Configuration
# ==========================================

# 1. Discord Bot Credentials (Required)
# Obtain these from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here
# Optional: Set GUILD_ID during testing for INSTANT slash command updates
# DISCORD_DEV_GUILD_ID=your_testing_server_id_here

# 2. Database Driver Configuration
# Options: "sqlite" (Local) | "turso" (Cloud LibSQL) | "postgres" (Supabase/Neon)
DB_DRIVER=sqlite
DB_SQLITE_PATH=local.db

# If DB_DRIVER=turso: (Free 9GB LibSQL at https://turso.tech/)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# If DB_DRIVER=postgres: (Free Supabase / Neon PostgreSQL)
DATABASE_URL=postgresql://postgres:password@db.xyz.supabase.co:5432/postgres

# 3. HTTP Server Port (Keep-Alive for Render / Koyeb / Fly.io)
# Render exposes PORT dynamically. The bot serves GET /health on this port.
PORT=8080

# 4. Permissions & Role Settings
# Staff role permitted to manage scrims (in addition to Server Administrators)
DEFAULT_ORGANIZER_ROLE=Scrim Organizer

# 5. Announcement Visuals (Optional Celebration GIFs/Images)
DEFAULT_WIN_GIF=https://media.giphy.com/media/26u4cqiYI30juCOGY/giphy.gif
DEFAULT_LOSS_GIF=https://media.giphy.com/media/3o7TKr3nzbh5WgCFxe/giphy.gif
DEFAULT_DRAW_GIF=https://media.giphy.com/media/l4KhQo2MESJkc6QbS/giphy.gif

# 6. Bot Defaults
DEFAULT_PREFIX=!
DEFAULT_MAX_SLOTS=25
DEBUG=false
